{
  "noBanner": true,
  "noProgress": true,
  "config": {
    "default": true,
    "MD003": { "style": "atx" },
    "MD004": { "style": "dash" },
    "MD007": { "indent": 4 },
    "MD009": { "br_spaces": 0 },
    "MD013": {
      "line_length": 80,
      "code_blocks": false,
      "headings": false,
      "tables": false
    },
    "MD024": { "siblings_only": false },
    "MD025": { "front_matter_title": "" },
    "MD029": { "style": "one_or_ordered" },
    "MD030": { "ul_single": 3, "ul_multi": 3, "ol_single": 2, "ol_multi": 2 },
    "MD033": { "allowed_elements": ["details", "summary"] },
    "MD035": { "style": "---" },
    "MD041": { "front_matter_title": "" },
    "MD046": { "style": "fenced" },
    "MD048": { "style": "backtick" },
    "MD049": { "style": "underscore" },
    "MD050": { "style": "asterisk" },
    "MD060": { "style": "aligned" }
  }
}
