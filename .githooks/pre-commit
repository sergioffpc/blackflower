#!/bin/bash
# Validate the index snapshot; preserve partial staging and the working tree.
set -euo pipefail

# Empty-tree commits in the commit-message integration test contain no source.
if [[ -z "$(git ls-files --cached)" ]]; then
  exit 0
fi

project_root=$(git rev-parse --show-toplevel)
node "${project_root}/tools/style/check-staged.mjs"
