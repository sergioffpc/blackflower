#usda 1.0
(
    defaultPrim = "Scenario"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Scenario"
{
    custom int blackflower:schema = 1

    def Scope "CollisionShapes"
    {
        def Cube "West"
        {
            custom uint blackflower:id = 1
            double size = 2
            double3 xformOp:translate = (-3, 1, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Cube "East"
        {
            custom uint blackflower:id = 2
            double size = 2
            double3 xformOp:translate = (3, 1, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Cube "Floor"
        {
            custom uint blackflower:id = 3
            double size = 1
            double3 xformOp:translate = (0, -0.1, 0)
            double3 xformOp:scale = (20.4, 0.2, 20.4)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "WestWall"
        {
            custom uint blackflower:id = 4
            double size = 1
            double3 xformOp:translate = (-10.1, 1.5, 0)
            double3 xformOp:scale = (0.2, 3, 20.4)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "EastWall"
        {
            custom uint blackflower:id = 5
            double size = 1
            double3 xformOp:translate = (10.1, 1.5, 0)
            double3 xformOp:scale = (0.2, 3, 20.4)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "SouthWall"
        {
            custom uint blackflower:id = 6
            double size = 1
            double3 xformOp:translate = (0, 1.5, -10.1)
            double3 xformOp:scale = (20, 3, 0.2)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "NorthWall"
        {
            custom uint blackflower:id = 7
            double size = 1
            double3 xformOp:translate = (0, 1.5, 10.1)
            double3 xformOp:scale = (20, 3, 0.2)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }
    def Scope "Lights"
    {
        def Xform "Ceiling"
        {
            custom token blackflower:lightType = "point"
            custom uint blackflower:id = 1
            custom float3 blackflower:color = (1, 1, 1)
            custom float blackflower:intensity = 1
            double3 xformOp:translate = (0, 3, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
    def Scope "Spawns"
    {
        def Xform "SouthWest"
        {
            custom uint blackflower:id = 1
            double3 xformOp:translate = (-8, 0, -8)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "NorthWest"
        {
            custom uint blackflower:id = 2
            double3 xformOp:translate = (-8, 0, 8)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "SouthEast"
        {
            custom uint blackflower:id = 3
            double3 xformOp:translate = (8, 0, -8)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "NorthEast"
        {
            custom uint blackflower:id = 4
            double3 xformOp:translate = (8, 0, 8)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}
