#usda 1.0
(
    defaultPrim = "Scenario"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Scenario"
{
    custom int blackflower:schema = 1
    custom string blackflower:scenario = "mvp"
    custom double2 blackflower:interior = (20, 20)
    custom double2 blackflower:wall = (3, 0.2)

    def Scope "Blocks"
    {
        def Cube "West"
        {
            custom uint blackflower:id = 1
            double size = 2
            double3 xformOp:translate = (-3, 1, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Cube "East"
        {
            custom uint blackflower:id = 2
            double size = 2
            double3 xformOp:translate = (3, 1, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
    def Capsule "Participant"
    {
        uniform token axis = "Y"
        double height = 1.2
        double radius = 0.3
        float3[] extent = [(-0.3, -0.9, -0.3), (0.3, 0.9, 0.3)]
    }
    def Scope "Spawns"
    {
        def Xform "SouthWest"
        {
            custom uint blackflower:id = 1
            double3 xformOp:translate = (-8, 0, -8)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "NorthWest"
        {
            custom uint blackflower:id = 2
            double3 xformOp:translate = (-8, 0, 8)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "SouthEast"
        {
            custom uint blackflower:id = 3
            double3 xformOp:translate = (8, 0, -8)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "NorthEast"
        {
            custom uint blackflower:id = 4
            double3 xformOp:translate = (8, 0, 8)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}
