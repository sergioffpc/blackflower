#usda 1.0
(
    defaultPrim = "Scene"
    metersPerUnit = 1
    upAxis = "Y"
)
def Xform "Scene"
{
    custom int blackflower:schema = 1
    def Scope "Entities"
    {
        def Xform "CollisionOnly" (
            prepend references = @../entities/floor.usda@
        )
        {
            custom string blackflower:id = "collision-only"
        }
        def Xform "VisualOnly" (
            prepend references = @../entities/visual.usda@
        )
        {
            custom string blackflower:id = "visual-only"
        }
        def Xform "AudioOnly" (
            prepend references = @../entities/audio.usda@
        )
        {
            custom string blackflower:id = "audio-only"
        }
        def Xform "Mixed" (
            prepend references = @../entities/mixed.usda@
        )
        {
            custom string blackflower:id = "mixed"
        }
    }
}
