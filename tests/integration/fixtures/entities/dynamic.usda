#usda 1.0
(
    defaultPrim = "Entity"
    metersPerUnit = 1
    upAxis = "Y"
)
def Xform "Entity"
{
    custom string blackflower:visual = "visual.mover"
    def Scope "Bounds"
    {
        custom token blackflower:collisionDomain = "AuthoritativeDynamic"

        def Cube "Body" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1
            bool physics:collisionEnabled = true
        }
    }
}
