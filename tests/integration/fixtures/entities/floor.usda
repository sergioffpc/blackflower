#usda 1.0
(
    defaultPrim = "Entity"
    metersPerUnit = 1
    upAxis = "Y"
)
def Xform "Entity"
{
    def Scope "Bounds"
    {
        custom token blackflower:collisionDomain = "SessionStatic"

        def Cube "Slab" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1
            double3 xformOp:translate = (0, -0.1, 0)
            double3 xformOp:scale = (20, 0.2, 20)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }
}
