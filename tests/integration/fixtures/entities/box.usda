#usda 1.0
(
    defaultPrim = "Entity"
    metersPerUnit = 1
    upAxis = "Y"
)
def Xform "Entity"
{
    def Scope "Bounds"
    {
        def Cube "Body" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1
            bool physics:collisionEnabled = true
        }
        def Cube "Cap" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 0.5
            double3 xformOp:translate = (1, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}
